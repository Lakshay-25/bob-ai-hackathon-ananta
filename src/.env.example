# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── Drishti Application Settings ──────────────────────────────────────────────
# Port for the Streamlit app (default: 8501)
APP_PORT=8501

# Set to "development" or "production"
APP_ENV=development

# ── Data Source ────────────────────────────────────────────────────────────────
# Path to the crime data CSV (relative to src/)
# Leave blank to use the default bundled crime_data.csv
CRIME_DATA_PATH=crime_data.csv

# ── Future: IBM watsonx.ai NLP Integration ────────────────────────────────────
# These are NOT required for the current MVP.
# They are placeholders for the planned natural language query feature.
# WATSONX_API_KEY=your_api_key_here
# WATSONX_PROJECT_ID=your_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
